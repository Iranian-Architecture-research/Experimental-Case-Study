@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ia: <https://example.org/iranian_architecture/thesaurus/> .
@prefix lcsh: <http://id.loc.gov/authorities/subjects/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wd: <https://www.wikidata.org/entity/> .
@prefix iconclass: <https://iconclass.org/> .

# Replace the example.org base with the project's persistent namespace before publication.

ia:scheme a skos:ConceptScheme ;
    dcterms:title "Iranian Architecture Thesaurus"@en, "واژگان معماری ایران"@fa ;
    dcterms:description "A small, multilingual starter vocabulary for Iranian architecture concepts and related documentary resource types."@en, "واژگان آغازین کوچک و چندزبانه برای مفاهیم معماری ایران و انواع اسناد مرتبط."@fa ;
    skos:hasTopConcept ia:construction_techniques, ia:building_materials, ia:building_use, ia:building_types, ia:architectural_components, ia:architectural_forms, ia:vaulting_systems, ia:pre_islamic_styles, ia:islamic_styles, ia:documents_by_form, ia:documents_by_function .

ia:technique_facet a skos:Collection ;
    skos:prefLabel "Technique"@en, "تکنیک"@fa ;
    skos:member ia:construction_techniques .

ia:materials_facet a skos:Collection ;
    skos:prefLabel "Materials and substances"@en, "متریال و مصالح"@fa ;
    skos:member ia:building_materials .

ia:use_facet a skos:Collection ;
    skos:prefLabel "Use"@en, "کاربرد"@fa ;
    skos:member ia:building_use .

ia:elements_facet a skos:Collection ;
    skos:prefLabel "Elements and components"@en, "المان‌ها و اجزاء"@fa ;
    skos:member ia:building_types, ia:architectural_components, ia:architectural_forms, ia:vaulting_systems .

ia:styles_facet a skos:Collection ;
    skos:prefLabel "Styles and periods"@en, "سبک و دوره"@fa ;
    skos:member ia:pre_islamic_styles, ia:islamic_styles .

ia:documentary_resources_facet a skos:Collection ;
    skos:prefLabel "Documentary resources"@en, "منابع و اسناد مستند"@fa ;
    skos:scopeNote "A starter facet for classifying source document types by form and function. It describes the source document, not its digital file format or IIIF representation."@en,
        "رده‌ای آغازین برای طبقه‌بندی نوع سند مبدأ بر پایهٔ شکل و کارکرد؛ این رده نوع سند را توصیف می‌کند، نه قالب فایل دیجیتال یا بازنمایی IIIF آن را."@fa ;
    skos:member ia:documents_by_form, ia:documents_by_function .

ia:documents_by_form a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Documents by form"@en, "اسناد بر اساس شکل"@fa ;
    skos:exactMatch aat:300137974 .

ia:photographs a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Photographs"@en, "عکس‌ها"@fa ;
    skos:exactMatch aat:300046300 ;
    skos:broadMatch aat:300191091 ;
    skos:broader ia:documents_by_form .

ia:aerial_photographs a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Aerial photographs"@en, "عکس‌های هوایی"@fa ;
    skos:exactMatch aat:300053443 ;
    skos:broadMatch aat:300138798 ;
    skos:broader ia:photographs .

ia:photographic_negatives a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Photographic negatives"@en, "نگاتیوهای عکاسی"@fa ;
    skos:broader ia:documents_by_form .

ia:photographic_slides a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Photographic slides"@en, "اسلایدهای عکاسی"@fa ;
    skos:broader ia:documents_by_form .

ia:maps a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Maps"@en, "نقشه‌ها"@fa ;
    skos:exactMatch aat:300028094 ;
    skos:broadMatch aat:300028052, aat:300026848 ;
    skos:broader ia:documents_by_form .

ia:architectural_drawings a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Architectural drawings"@en, "نقشه‌ها و ترسیم‌های معماری"@fa ;
    skos:broader ia:documents_by_form .

ia:plans a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Architectural plans"@en, "پلان‌های معماری"@fa ;
    skos:exactMatch aat:300034104 ;
    skos:broadMatch aat:300034017 ;
    skos:broader ia:architectural_drawings .

ia:documents_by_function a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Documents by function"@en, "اسناد بر اساس کارکرد"@fa ;
    skos:scopeNote "A starter grouping for documents classified by intended function. Add narrower concepts only when a project's use cases and authoritative mappings are documented."@en,
        "گروه‌بندی آغازین اسناد بر پایهٔ کارکرد موردنظر؛ مفاهیم خاص‌تر فقط پس از مستندسازی نیاز پروژه و نگاشت معتبر افزوده شوند."@fa ;
    skos:exactMatch aat:300137955 .


ia:certificate a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Certificate"@en, "گواهینامه/مجوز"@fa ;
    skos:exactMatch aat:300026841 ;
    skos:broadMatch aat:300137955 ;
    skos:broader ia:documents_by_function .

    
ia:gift_certificate a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "gift certificates"@en, "گواهینامه‌های بخشش/انفاق"@fa ;
    skos:exactMatch aat:300195422 ;
    skos:broadMatch aat:300026841 ;
    skos:broader ia:certificate .

ia:endownment_certificate a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "endowment certificates"@en, "وقف‌نامه"@fa ;
    skos:broadMatch aat:300195422 ;
    skos:broader ia:gift_certificate .    



