     .

ia:muqarnas a skos:Concept ;
    skos:inScheme ia:scheme ;
    skos:prefLabel "Muqarnas"@en, "مقرنس"@fa ;
    skos:scopeNote "A three-dimensional ornamental architectural element; it may also be analyzed as a surface system."@en, "عنصر تزیینی سه‌بعدی معماری که می‌تواند به‌عنوان سامانه‌ای سطحی نیز تحلیل شود."@fa ;
    skos:broader ia:architectural_components ;
    skos:related ia:muqarnas_surface_system .

